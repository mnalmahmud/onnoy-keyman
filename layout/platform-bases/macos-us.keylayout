  </keyMapSet>
  <actions>
    <action id="1">
			<when state="none" next="2"/>
		</action>
    <action id="5">
			<when state="none" output=" "/>
			<when state="1" output="´"/>
			<when state="2" output="`"/>
			<when state="3" output="ˆ"/>
			<when state="4" output="¨"/>
			<when state="5" output="˜"/>
		</action>
  </actions>
  <terminators>
		<when state="1" output="´"/>
		<when state="2" output="`"/>
		<when state="3" output="ˆ"/>
		<when state="4" output="¨"/>
		<when state="5" output="˜"/>
	</terminators>
