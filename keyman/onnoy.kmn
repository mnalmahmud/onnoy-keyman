c Onnoy: positional Unicode keyboard; maintain alongside layout.toml.
store(&VERSION) '15.0'
store(&NAME) 'Onnoy'
store(&KEYBOARDVERSION) '1.0'
store(&TARGETS) 'any'
store(&layoutfile) 'onnoy.keyman-touch-layout'
begin Unicode > use(main)

group(main) using keys
+ [K_BKQUOTE] > U+09CD
+ [SHIFT K_BKQUOTE] > U+09BC
+ [RALT K_BKQUOTE] > U+0060
+ [SHIFT RALT K_BKQUOTE] > U+007E
+ [K_1] > U+09E7
