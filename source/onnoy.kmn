c Onnoy (অন্বয়) — Bengali-first Unicode keyboard
c Canonical desktop keymap; physical US-QWERTY positions.
c Generated from audit.json; edit the mapping inventory first.
store(&VERSION) '16.0'
store(&NAME) 'Onnoy (অন্বয়)'
store(&KEYBOARDVERSION) '1.0'
store(&TARGETS) 'desktop web'

begin Unicode > use(main)

group(main) using keys

c Letters — Normal / Shift / Right Alt (AltGr) / Shift+Right Alt

c Q: ট / ঠ / — / —
+ [K_Q] > U+099F
+ [SHIFT K_Q] > U+09A0
+ [RALT K_Q] > nul
+ [SHIFT RALT K_Q] > nul

c W: ড / ঢ / ড় / ঢ়
+ [K_W] > U+09A1
+ [SHIFT K_W] > U+09A2
+ [RALT K_W] > U+09DC
+ [SHIFT RALT K_W] > U+09DD

c E: ে / এ / ৈ / ঐ
+ [K_E] > U+09C7
+ [SHIFT K_E] > U+098F
+ [RALT K_E] > U+09C8
+ [SHIFT RALT K_E] > U+0990

c R: র / ৃ / ঋ / ৰ
+ [K_R] > U+09B0
+ [SHIFT K_R] > U+09C3
+ [RALT K_R] > U+098B
+ [SHIFT RALT K_R] > U+09F0

c T: ত / থ / ৎ / —
+ [K_T] > U+09A4
+ [SHIFT K_T] > U+09A5
+ [RALT K_T] > U+09CE
+ [SHIFT RALT K_T] > nul

c Y: য / য় / — / —
+ [K_Y] > U+09AF
+ [SHIFT K_Y] > U+09DF
+ [RALT K_Y] > nul
+ [SHIFT RALT K_Y] > nul

c U: ু / উ / ূ / ঊ
+ [K_U] > U+09C1
+ [SHIFT K_U] > U+0989
+ [RALT K_U] > U+09C2
+ [SHIFT RALT K_U] > U+098A

c I: ি / ই / ী / ঈ
+ [K_I] > U+09BF
+ [SHIFT K_I] > U+0987
+ [RALT K_I] > U+09C0
+ [SHIFT RALT K_I] > U+0988

c O: ো / ও / ৌ / ঔ
+ [K_O] > U+09CB
+ [SHIFT K_O] > U+0993
+ [RALT K_O] > U+09CC
+ [SHIFT RALT K_O] > U+0994

c P: প / ফ / — / —
+ [K_P] > U+09AA
+ [SHIFT K_P] > U+09AB
+ [RALT K_P] > nul
+ [SHIFT RALT K_P] > nul

c A: া / আ / ঽ / —
+ [K_A] > U+09BE
+ [SHIFT K_A] > U+0986
+ [RALT K_A] > U+09BD
+ [SHIFT RALT K_A] > nul

c S: স / শ / — / —
+ [K_S] > U+09B8
+ [SHIFT K_S] > U+09B6
+ [RALT K_S] > nul
+ [SHIFT RALT K_S] > nul

c D: দ / ধ / — / —
+ [K_D] > U+09A6
+ [SHIFT K_D] > U+09A7
+ [RALT K_D] > nul
+ [SHIFT RALT K_D] > nul

c F: ্ / ় / — / —
+ [K_F] > U+09CD
+ [SHIFT K_F] > U+09BC
+ [RALT K_F] > nul
+ [SHIFT RALT K_F] > nul

c G: গ / ঘ / — / —
+ [K_G] > U+0997
+ [SHIFT K_G] > U+0998
+ [RALT K_G] > nul
+ [SHIFT RALT K_G] > nul

c H: হ / ঃ / — / —
+ [K_H] > U+09B9
+ [SHIFT K_H] > U+0983
+ [RALT K_H] > nul
+ [SHIFT RALT K_H] > nul

c J: জ / ঝ / — / —
+ [K_J] > U+099C
+ [SHIFT K_J] > U+099D
+ [RALT K_J] > nul
+ [SHIFT RALT K_J] > nul

c K: ক / খ / — / —
+ [K_K] > U+0995
+ [SHIFT K_K] > U+0996
+ [RALT K_K] > nul
+ [SHIFT RALT K_K] > nul

c L: ল / — / — / —
+ [K_L] > U+09B2
+ [SHIFT K_L] > nul
+ [RALT K_L] > nul
+ [SHIFT RALT K_L] > nul

c Z: ঞ / ঙ / ZWNJ / ZWJ
+ [K_Z] > U+099E
+ [SHIFT K_Z] > U+0999
+ [RALT K_Z] > U+200C
+ [SHIFT RALT K_Z] > U+200D

c X: ষ / — / — / —
+ [K_X] > U+09B7
+ [SHIFT K_X] > nul
+ [RALT K_X] > nul
+ [SHIFT RALT K_X] > nul

c C: চ / ছ / — / —
+ [K_C] > U+099A
+ [SHIFT K_C] > U+099B
+ [RALT K_C] > nul
+ [SHIFT RALT K_C] > nul

c V: অ / ৱ / ৗ / —
+ [K_V] > U+0985
+ [SHIFT K_V] > U+09F1
+ [RALT K_V] > U+09D7
+ [SHIFT RALT K_V] > nul

c B: ব / ভ / — / —
+ [K_B] > U+09AC
+ [SHIFT K_B] > U+09AD
+ [RALT K_B] > nul
+ [SHIFT RALT K_B] > nul

c N: ন / ণ / — / —
+ [K_N] > U+09A8
+ [SHIFT K_N] > U+09A3
+ [RALT K_N] > nul
+ [SHIFT RALT K_N] > nul

c M: ম / ং / ঁ / —
+ [K_M] > U+09AE
+ [SHIFT K_M] > U+0982
+ [RALT K_M] > U+0981
+ [SHIFT RALT K_M] > nul

c Number row: Bengali digits, familiar Shift symbols, Latin digits on AltGr.

+ [K_1] > U+09E7
+ [SHIFT K_1] > U+0021
+ [RALT K_1] > U+0031
+ [SHIFT RALT K_1] > nul

+ [K_2] > U+09E8
+ [SHIFT K_2] > U+0040
+ [RALT K_2] > U+0032
+ [SHIFT RALT K_2] > nul

+ [K_3] > U+09E9
+ [SHIFT K_3] > U+0023
+ [RALT K_3] > U+0033
+ [SHIFT RALT K_3] > nul

+ [K_4] > U+09EA
+ [SHIFT K_4] > U+09F3
+ [RALT K_4] > U+0034
+ [SHIFT RALT K_4] > U+0024

+ [K_5] > U+09EB
+ [SHIFT K_5] > U+0025
+ [RALT K_5] > U+0035
+ [SHIFT RALT K_5] > nul

+ [K_6] > U+09EC
+ [SHIFT K_6] > U+005E
+ [RALT K_6] > U+0036
+ [SHIFT RALT K_6] > nul

+ [K_7] > U+09ED
+ [SHIFT K_7] > U+0026
+ [RALT K_7] > U+0037
+ [SHIFT RALT K_7] > nul

+ [K_8] > U+09EE
+ [SHIFT K_8] > U+002A
+ [RALT K_8] > U+0038
+ [SHIFT RALT K_8] > nul

+ [K_9] > U+09EF
+ [SHIFT K_9] > U+0028
+ [RALT K_9] > U+0039
+ [SHIFT RALT K_9] > nul

+ [K_0] > U+09E6
+ [SHIFT K_0] > U+0029
+ [RALT K_0] > U+0030
+ [SHIFT RALT K_0] > nul

c Period: Bengali danda, greater-than, literal period, blank.
+ [K_PERIOD] > U+0964
+ [SHIFT K_PERIOD] > U+003E
+ [RALT K_PERIOD] > U+002E
+ [SHIFT RALT K_PERIOD] > nul

c Other punctuation is passed through from the host keyboard (expected US-QWERTY).
c System shortcuts and Ctrl/Meta combinations are not overridden.